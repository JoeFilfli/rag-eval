# LLM
LLM_PROVIDER=openai          # openai | anthropic
LLM_MODEL=gpt-4o

OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Embeddings
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# Retrieval tuning
RETRIEVAL_K=5
CHUNK_SIZE=512
CHUNK_OVERLAP=50

# Document storage (local only)
DOCUMENT_STORE_PATH=./documents

# Database — overridden to db:5432 automatically inside Docker
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rag
